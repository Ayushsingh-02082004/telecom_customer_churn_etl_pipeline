# =============================================================================
# Telecom Customer Churn - .gitignore
# =============================================================================

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
ENV/
env/

# Pytest & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# Airflow runtime & logs
logs/
airflow/logs/
*.log
*.pid

# Sensitive credentials & environment files
.env
*.env.local
secrets/
airflow/secrets/
*.pem
*.key
id_ed25519*
id_rsa*

# Raw data files (retain README.md)
data/*.csv
data/*.xlsx
*.csv

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
